// Gothic Atlas is a static site served by Cloudflare Workers static assets.
// Deploy: npm run build && npx wrangler deploy
{
  "name": "gothic-atlas",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash"
  },
  "routes": [{ "pattern": "gothic.onuralp.co", "custom_domain": true }]
}
