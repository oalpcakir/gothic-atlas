    {"from": 1401, "to": 1448, "part": "chapels", "what": "Saint-Sépulcre chapel (1401) and Saint-Michel chapel (1448) added", "source": "https://fr.wikipedia.org/wiki/Cathédrale_Saint-Jean-Baptiste_de_Lyon", "certainty": "documented"},
