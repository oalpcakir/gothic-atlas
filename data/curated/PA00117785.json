  "events": [
    {"year": 1245, "type": "other", "what": "First Council of Lyon held at the cathedral; a second followed in 1274.", "source": "https://fr.wikipedia.org/wiki/Cathédrale_Saint-Jean-Baptiste_de_Lyon"},
    {"year": 1562, "type": "war", "what": "Baron des Adrets's troops destroy the rood screen and many façade statues, and damage the clock.", "source": "https://fr.wikipedia.org/wiki/Cathédrale_Saint-Jean-Baptiste_de_Lyon"},
    {"year": 1697, "type": "other", "what": "Attempts to consolidate the façade, to 1706 (Saquin, then de la Monce).", "source": "https://fr.wikipedia.org/wiki/Cathédrale_Saint-Jean-Baptiste_de_Lyon"},
    {"year": 1793, "type": "revolution", "what": "Choir altered, rood screen removed, damage during the siege of Lyon, and the building used for the Cult of Reason.", "source": "https://fr.wikipedia.org/wiki/Cathédrale_Saint-Jean-Baptiste_de_Lyon"},
    {"year": 1802, "type": "other", "what": "Worship resumes on 6 June after the Concordat; works done by November 1804 for Pius VII's visit.", "source": "https://fr.wikipedia.org/wiki/Cathédrale_Saint-Jean-Baptiste_de_Lyon"},
