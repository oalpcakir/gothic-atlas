    {"from": 1480, "to": 1500, "part": "chapels", "what": "Bourbon chapel started 1480 and finished in the early 16th century; façade sculpture installed 1481", "source": "https://fr.wikipedia.org/wiki/Cathédrale_Saint-Jean-Baptiste_de_Lyon", "certainty": "documented"}
